# Public PostHog project ingest token, never a personal/operations API key.
# Export these when building/running Rust binaries.
ZUSE_POSTHOG_KEY=
ZUSE_POSTHOG_HOST=https://us.i.posthog.com
ZUSE_POSTHOG_ENABLE_DEV=0
# Set to 0 to disable engine analytics regardless of the saved preference.
ZUSE_ANALYTICS_ENABLED=1

# Browser: export at build time or copy to apps/web-solid/.env.local.
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://us.i.posthog.com
VITE_POSTHOG_ENABLE_DEV=0

# Expo: copy to apps/mobile/.env.local or configure the Expo build environment.
EXPO_PUBLIC_POSTHOG_KEY=
EXPO_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
EXPO_PUBLIC_POSTHOG_ENABLE_DEV=0

# Operations-only dashboard provisioning. Never prefix these with VITE_/EXPO_PUBLIC_.
POSTHOG_PROJECT_ID=
POSTHOG_CONTROL_HOST=https://us.posthog.com
POSTHOG_PERSONAL_API_KEY=
